---
import { site } from "../data/site.js";

const year = new Date().getFullYear();
---

<footer>
  <div class="shell bar">
    <p class="muted">© {year} {site.name}</p>
    <ul>
      {
        site.links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    margin-block-start: 5rem;
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 2rem;
    font-size: 0.9rem;
  }

  ul {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
