---
import { site, company } from "../data/site.js";

const year = new Date().getFullYear();
---

<footer>
  <div class="shell bar">
    <p class="muted">© {year} {company.legalName}</p>
    <ul>
      {
        site.links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="shell legal">
    <p class="muted">
      {company.legalName} is registered in England and Wales, company no.
      {" "}<a href={company.registerUrl}>{company.number}</a>. Registered office:
      {" "}{company.registeredOffice}. Founded and wholly owned by {company.owner}.
      {" "}<a href="/about/#company-details">Company details</a>.
    </p>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    margin-block-start: 5rem;
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 2rem 1.25rem;
    font-size: 0.9rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .legal {
    padding-block-end: 2.5rem;
    max-width: 68ch;
  }

  .legal p {
    font-size: 0.8rem;
    line-height: 1.6;
  }
</style>
