---
import Base from "../layouts/Base.astro";
import ProjectList from "../components/ProjectList.astro";
import { projects } from "../data/site.js";
---

<Base title="Work" description="Selected projects.">
  <section class="shell page">
    <h1>Work</h1>
    <p class="lede muted">
      Consumer products built end to end by Hughes Zane Ltd. — written, designed, shipped and
      marketed in-house. Combined 1M followers across platforms.
    </p>
    <ProjectList items={projects} />
  </section>
</Base>

<style>
  .page {
    padding-block: clamp(2.5rem, 8vw, 4.5rem) 0;
  }

  h1 {
    font-size: clamp(1.9rem, 5vw, 2.6rem);
  }

  .lede {
    margin-block: 1.25rem 3rem;
    max-width: 58ch;
  }
</style>
