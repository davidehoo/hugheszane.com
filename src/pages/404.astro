---
import Base from "../layouts/Base.astro";
---

<Base title="Not found" description="That page doesn't exist.">
  <section class="shell page">
    <h1>Not found</h1>
    <p class="muted">That page doesn't exist. <a href="/">Back to the start</a>.</p>
  </section>
</Base>

<style>
  .page {
    padding-block: clamp(3rem, 10vw, 6rem);
  }

  h1 {
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    margin-block-end: 1rem;
  }
</style>
